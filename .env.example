# Token du bot obtenu via @BotFather. Ne jamais commiter la vraie valeur.
BOT_TOKEN=

# Secret utilisé pour valider le header X-Telegram-Bot-Api-Secret-Token
# des requêtes webhook entrantes. Requis si USE_WEBHOOK=true.
WEBHOOK_SECRET_TOKEN=

# URL publique HTTPS complète du webhook (ex: https://example.com/webhook).
# Requis si USE_WEBHOOK=true.
WEBHOOK_URL=

# Chemin de l'endpoint webhook exposé par le serveur aiohttp.
WEBHOOK_PATH=/webhook

# Interface et port sur lesquels le serveur aiohttp écoute (mode webhook).
# Sur Railway, la variable PORT est injectée automatiquement et prioritaire
# sur WEBAPP_PORT (voir config.py) : inutile de la définir manuellement.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# false = polling (développement local), true = webhook (production).
USE_WEBHOOK=false

# Niveau de log (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Chemin du fichier de logs (warnings/erreurs uniquement).
LOG_FILE_PATH=logs/errors.log

# Chaîne de connexion PostgreSQL (catalogue de services + panier + commandes).
# Sur Railway : ajoute un plugin PostgreSQL puis référence sa variable :
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Requis si USE_WEBHOOK=true.
DATABASE_URL=

# URL publique HTTPS servant la Mini App (fichiers de webapp/).
# Sur Railway : MINI_APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/webapp/
# Requis si USE_WEBHOOK=true.
MINI_APP_URL=

# Nom court de la Mini App dans @BotFather (/newapp), pour un lien du type
# https://t.me/TON_BOT/shop . Laisse vide tant que ce n'est pas créé :
# le bot utilisera alors https://t.me/TON_BOT?startapp
MINI_APP_SHORT_NAME=

# ID Telegram numérique de l'administrateur (toi). Reçoit les notifications de
# commande/gain à la roue et est seul autorisé à utiliser les commandes admin
# (/addslot, /slots, /confirm). Pour connaître ton ID, envoie /start à
# @userinfobot sur Telegram. Requis si USE_WEBHOOK=true.
ADMIN_USER_ID=

# (Optionnel) Chat ou groupe "Drive" : dépose photos/vidéos dedans, le bot
# les range automatiquement dans File photos / File vidéos.
# Crée un groupe, ajoute le bot admin, envoie un message, puis mets l'ID ici
# (souvent un nombre négatif, ex: -100123...). Sinon utilise /depot en privé.
STOCK_DEPOSIT_CHAT_ID=

# Lien PayPal affiché après commande (ex: https://paypal.me/toncompte).
PAYPAL_URL=

# Coordonnées de virement affichées après commande.
BANK_IBAN=
BANK_HOLDER=

# Adresses crypto affichées après commande (tap pour copier).
CRYPTO_SOLANA=
CRYPTO_ETHEREUM=
CRYPTO_BITCOIN=
